{
  "name": "termyte",
  "version": "1.0.9",
  "description": "Local-first context engine for coding agents",
  "repository": "https://github.com/termyte-labs/termyte",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "termyte": "dist/cli/index.js",
    "termyte-hook": "dist/cli/hook.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --exclude test/installed-pipeline.test.ts",
    "test:package": "vitest run test/installed-pipeline.test.ts",
    "verify": "npm run typecheck && npm run build && npm test && npm run test:package",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "better-sqlite3": "^11.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
