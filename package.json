{
  "name": "termyte",
  "version": "0.3.1",
  "description": "A local-first safety runtime for checking risky agent commands, applying policies, and recording local operational memory.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/termyte-labs/termyte.git"
  },
  "keywords": [
    "ai-agents",
    "agent-safety",
    "runtime-safety",
    "cli",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "termyte": "dist/cli.js"
  },
  "files": [
    "dist",
    "benchmarks/commands.json",
    "benchmarks/governance.json",
    "README.md",
    "docs",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bench:generate": "node scripts/generate-governance-benchmarks.mjs",
    "bench": "node dist/cli.js bench",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:package": "node scripts/validate-package.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "fast-glob": "^3.3.3",
    "termyte": "^0.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.21",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
