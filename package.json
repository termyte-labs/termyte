{
  "name": "termyte",
  "version": "0.2.9",
  "description": "Termyte is a local-first runtime safety layer for AI coding agents. It sits between an agent and the shell, normalizes the action semantically, resolves targets, scores blast radius, checks policy and memory, then decides whether to `allow`, `warn`, or `block`.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/termyte-labs/termyte.git"
  },
  "keywords": [
    "ai-agents",
    "agent-safety",
    "runtime-safety",
    "cli",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "termyte": "dist/cli.js"
  },
  "files": [
    "dist",
    "benchmarks/commands.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.21",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
