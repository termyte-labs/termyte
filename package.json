{
  "name": "termyte",
  "version": "1.0.0",
  "description": "Local-first memory layer for AI coding agents. Persistent context across sessions — works with Claude Code, Codex, OpenCode, Cursor, Gemini, Windsurf, and Copilot.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/termyte-labs/termyte#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/termyte-labs/termyte.git"
  },
  "bugs": {
    "url": "https://github.com/termyte-labs/termyte/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/palguna26"
  },
  "keywords": [
    "ai",
    "ai-coding",
    "ai-agent",
    "ai-agents",
    "ai-coding-agent",
    "agent",
    "agentic",
    "agentic-ai",
    "claude",
    "claude-code",
    "claude-mem",
    "codex",
    "coding-agent",
    "context",
    "context-engineering",
    "copilot",
    "cursor",
    "gemini",
    "gemini-cli",
    "llm",
    "long-term-memory",
    "machine-learning",
    "memory",
    "memory-layer",
    "opencode",
    "rag",
    "retrieval-augmented-generation",
    "semantic-search",
    "sqlite",
    "sqlite-vec",
    "termyte",
    "transformers",
    "vector-search",
    "windsurf"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "termyte": "dist/cli/index.js",
    "termyte-hook": "dist/cli/hook.js",
    "termyte-worker": "dist/cli/worker.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CHANGELOG.md",
    "llm.txt",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.11.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "sqlite-vec-windows-x64": "^0.1.9"
  }
}
